generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("ADMIN") // ADMIN, MANAGER, STAFF
  createdAt DateTime @default(now())
}

model Account {
  id         String     @id @default(cuid())
  familyName String
  email      String     @unique
  phone      String
  address    String?
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  type       String   // PARENT, CHILD
  birthDate  DateTime?
  gender     String?
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Deal {
  id          String     @id @default(cuid())
  title       String     // e.g. "Tommy's Nursery Admission"
  childName   String
  program     String     // PLAYGROUP, NURSERY, JUNIOR_KG, SENIOR_KG
  stage       String     // BOOK_VISIT, MEET_EDUCATORS, APP_SUBMISSION, CONFIRMATION, WELCOME
  status      String     @default("OPEN") // OPEN, WON, LOST
  healthScore Int        @default(100)
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  activities  Activity[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Activity {
  id          String   @id @default(cuid())
  type        String   // CALL, EMAIL, MEETING, NOTE, SYSTEM
  description String
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dealId      String?
  deal        Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
